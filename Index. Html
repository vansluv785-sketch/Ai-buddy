<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Buddy - AI Assistant</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f6fb;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 100%;
      max-width: 700px;
      height: 95vh;
      background: white;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.12);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .header {
      background: #5b4cff;
      color: white;
      padding: 20px;
      text-align: center;
    }

    .header h1 {
      font-size: 25px;
    }

    .header p {
      margin-top: 5px;
      opacity: 0.9;
    }

    .quick-buttons {
      display: flex;
      gap: 8px;
      padding: 12px;
      overflow-x: auto;
      border-bottom: 1px solid #eee;
    }

    .quick-buttons button {
      border: none;
      background: #f0efff;
      color: #4b3cff;
      padding: 10px 14px;
      border-radius: 20px;
      white-space: nowrap;
      cursor: pointer;
    }

    .quick-buttons button:hover {
      background: #dedbff;
    }

    .chat {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
    }

    .message {
      max-width: 80%;
      padding: 12px 15px;
      margin-bottom: 14px;
      border-radius: 15px;
      line-height: 1.5;
    }

    .ai {
      background: #f0f1f5;
      color: #222;
      border-bottom-left-radius: 4px;
    }

    .user {
      background: #5b4cff;
      color: white;
      margin-left: auto;
      border-bottom-right-radius: 4px;
    }

    .input-area {
      display: flex;
      gap: 10px;
      padding: 15px;
      border-top: 1px solid #eee;
    }

    #userInput {
      flex: 1;
      padding: 13px 15px;
      border: 1px solid #ddd;
      border-radius: 25px;
      outline: none;
      font-size: 15px;
    }

    #sendBtn {
      width: 50px;
      height: 50px;
      border: none;
      border-radius: 50%;
      background: #5b4cff;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }

    #sendBtn:hover {
      background: #4939e8;
    }

    @media (max-width: 600px) {
      .app {
        height: 100vh;
        border-radius: 0;
      }

      .message {
        max-width: 90%;
      }
    }
  </style>
</head>

<body>

  <div class="app">

    <div class="header">
      <h1>🤖 AI Buddy</h1>
      <p>Your personal AI assistant</p>
    </div>

    <div class="quick-buttons">
      <button onclick="quickAsk('Help me with my homework')">📚 Homework</button>
      <button onclick="quickAsk('Explain this topic simply')">🧠 Explain</button>
      <button onclick="quickAsk('Help me write something')">✍️ Writing</button>
      <button onclick="quickAsk('Give me some ideas')">💡 Ideas</button>
    </div>

    <div class="chat" id="chat">

      <div class="message ai">
        👋 Hi! I'm AI Buddy. How can I help you today?
      </div>

    </div>

    <div class="input-area">
      <input
        type="text"
        id="userInput"
        placeholder="Ask me anything..."
        onkeydown="handleEnter(event)"
      >

      <button id="sendBtn" onclick="sendMessage()">➤</button>
    </div>

  </div>

  <script>

    function addMessage(text, type) {
      const chat = document.getElementById("chat");

      const message = document.createElement("div");
      message.className = "message " + type;
      message.textContent = text;

      chat.appendChild(message);
      chat.scrollTop = chat.scrollHeight;
    }

    function sendMessage() {

      const input = document.getElementById("userInput");
      const text = input.value.trim();

      if (text === "") return;

      addMessage(text, "user");

      input.value = "";

      setTimeout(() => {

        let reply;

        const lower = text.toLowerCase();

        if (lower.includes("hello") || lower.includes("hi")) {
          reply = "Hello! 👋 I'm ready to help you.";
        }

        else if (lower.includes("homework") || lower.includes("study")) {
          reply = "Sure! 📚 Send me your question and I'll help you understand it step by step.";
        }

        else if (lower.includes("write")) {
          reply = "Of course! ✍️ Tell me what you want to write and I'll help you.";
        }

        else if (lower.includes("idea")) {
          reply = "💡 I can help you generate ideas. Tell me the topic!";
        }

        else {
          reply = "I received your question! 🤖 Connect this website to an AI API to get real AI-generated answers.";
        }

        addMessage(reply, "ai");

      }, 600);
    }

    function quickAsk(text) {
      document.getElementById("userInput").value = text;
      sendMessage();
    }

    function handleEnter(event) {
      if (event.key === "Enter") {
        sendMessage();
      }
    }

  </script>

</body>
</html>
